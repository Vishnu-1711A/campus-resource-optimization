# Copy this file to .env and fill in your MySQL password so the app writes to MySQL
# (otherwise it falls back to app/campus_resource.db - a SQLite file).
DB_BACKEND=auto          # auto | mysql | sqlite
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASS=your_mysql_password
DB_NAME=campus_resource_optimization

# NoSQL (sessions + activity log)
NOSQL_BACKEND=auto       # auto | mongodb | file
MONGO_URI=mongodb://localhost:27017
MONGO_DB=campus_resource_nosql

# Seconds between scheduler runs that free resources whose booking slot has ended
SYNC_INTERVAL_SECONDS=5
